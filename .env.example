# Verejná adresa webu (metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Variant na úvodnej stránke "/": afterglow | blackout
NEXT_PUBLIC_VARIANT=afterglow

# Plávajúci prepínač variantov (na prezentáciu klientovi)
NEXT_PUBLIC_SHOW_VARIANT_SWITCH=true

# Google Analytics 4. Produkčný build použije G-5QQ4H9GZST sám; lokálne sa meria len keď je toto nastavené.
# NEXT_PUBLIC_GA_ID=G-5QQ4H9GZST
